[
  {
    "id": "shared-newest-session",
    "description": "REPL-007 common history picks newest shared session entry",
    "source": {
      "history": [
        {"session_id": "s1", "source_sequence": 10},
        {"session_id": "s2", "source_sequence": 20}
      ]
    },
    "target": {
      "history": [
        {"session_id": "s1", "source_sequence": 10},
        {"session_id": "s3", "source_sequence": 15}
      ]
    },
    "expected_common_sequence": 10
  },
  {
    "id": "no-common-session",
    "description": "No shared session restarts from sequence 0",
    "source": {
      "history": [{"session_id": "x", "source_sequence": 1}]
    },
    "target": {
      "history": [{"session_id": "y", "source_sequence": 1}]
    },
    "expected_common_sequence": 0
  },
  {
    "id": "both-nil",
    "description": "Missing checkpoints restart from 0",
    "source": null,
    "target": null,
    "expected_common_sequence": 0
  },
  {
    "id": "prefer-higher-shared-sequence",
    "description": "When multiple shared sessions exist, prefer the higher source_sequence",
    "source": {
      "history": [
        {"session_id": "old", "source_sequence": 5},
        {"session_id": "new", "source_sequence": 40}
      ]
    },
    "target": {
      "history": [
        {"session_id": "old", "source_sequence": 5},
        {"session_id": "new", "source_sequence": 40}
      ]
    },
    "expected_common_sequence": 40
  },
  {
    "id": "epoch-mismatch-bootstrap",
    "description": "Checkpoint history epoch mismatch requires bootstrap from retention floor even when sessions match",
    "source": {
      "source_history_epoch": "epoch-old",
      "history": [{"session_id": "s1", "source_sequence": 50}]
    },
    "target": {
      "source_history_epoch": "epoch-old",
      "history": [{"session_id": "s1", "source_sequence": 50}]
    },
    "source_identity": {
      "history_epoch": "epoch-new",
      "compaction_epoch": 2,
      "retention_floor_sequence": 15
    },
    "expected_common_sequence": 50,
    "expected_reconcile": {
      "bootstrap_required": true,
      "reason": "epoch_mismatch",
      "since": 15
    }
  },
  {
    "id": "checkpoint-below-floor-bootstrap",
    "description": "Shared checkpoint sequence below retention floor requires bootstrap",
    "source": {
      "source_history_epoch": "epoch-a",
      "history": [{"session_id": "s1", "source_sequence": 5}]
    },
    "target": {
      "source_history_epoch": "epoch-a",
      "history": [{"session_id": "s1", "source_sequence": 5}]
    },
    "source_identity": {
      "history_epoch": "epoch-a",
      "compaction_epoch": 1,
      "retention_floor_sequence": 20
    },
    "expected_common_sequence": 5,
    "expected_reconcile": {
      "bootstrap_required": true,
      "reason": "below_floor",
      "since": 20
    }
  }
]
